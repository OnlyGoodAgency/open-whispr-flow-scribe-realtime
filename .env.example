# Copy to .env only for local testing. In Coolify, add these as runtime variables.
# Never expose OPENROUTER_API_KEY or ELEVENLABS_API_KEY to an installed client.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
CLIENT_API_KEY=replace-with-a-random-64-character-secret
SUPABASE_URL=https://your-project-ref.supabase.co
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-key
REALTIME_MAX_SECONDS=900
STT_PRIMARY_MODEL=openai/whisper-large-v3-turbo
STT_FALLBACK_MODEL=openai/whisper-1
TEXT_CLEANUP_ENABLED=true
TEXT_CLEANUP_MODEL=openai/gpt-4.1-mini
MAX_UPLOAD_MB=25
UPSTREAM_TIMEOUT_SECONDS=60
APP_URL=https://dictation.example.com
APP_TITLE=OpenWhisperFlow
