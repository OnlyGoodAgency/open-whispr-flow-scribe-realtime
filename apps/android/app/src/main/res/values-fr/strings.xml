    <string name="settings_dictation_vocabulary_hint">Un terme par ligne, jusqu’à 50 termes. Pour corriger un nom mal reconnu : Akme =&gt; Acme. Chaque orthographe peut contenir jusqu’à 80 caractères.</string>
    <string name="settings_dictation_learning">Apprendre mon vocabulaire</string>
    <string name="settings_dictation_context">Utiliser le texte affiché pour l’orthographe</string>
