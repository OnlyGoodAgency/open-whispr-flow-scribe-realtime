    <string name="floating_mic_permission_missing">Ouvrez OpenWhisperFlow et autorisez d’abord l’accès au microphone.</string>
    <string name="floating_mic_service_unavailable">Le service vocal OpenWhisperFlow n’est pas prêt. Réessayez.</string>
    <string name="floating_mic_model_missing">Téléchargez un modèle vocal dans OpenWhisperFlow ou configurez un serveur partagé.</string>
    <string name="floating_mic_engine_failed">La reconnaissance vocale n’a pas pu démarrer. Ouvrez OpenWhisperFlow et essayez un autre modèle.</string>
    <string name="floating_mic_no_transcription">Aucune parole n’a été détectée.</string>
